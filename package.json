  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/utils/scannerEngine.test.ts server/liveCheckers/liveCheckers.test.ts firestore.rules.test.ts server/androidIntegration.test.ts",
    "test:e2e": "node --import tsx tests/e2e/run.ts",
    "test:e2e:prod": "node --import tsx tests/e2e/run.ts --tier prod",
    "test:e2e:tier1": "node --import tsx tests/e2e/run.ts --tier 1",
    "test:e2e:tier2": "node --import tsx tests/e2e/run.ts --tier 2",
    "test:e2e:tier3": "node --import tsx tests/e2e/run.ts --tier 3",
    "test:e2e:tier4": "node --import tsx tests/e2e/run.ts --tier 4",
    "test:e2e:android": "node --import tsx tests/e2e/run.ts --tier android",
    "test:e2e:all": "node --import tsx tests/e2e/run.ts --tier all"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
